<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LINKO</AssemblyName>
    <Product>LINKO</Product>
    <Title>LINKO</Title>
    <ApplicationIcon>Assets/linko.ico</ApplicationIcon>
    <RootNamespace>ConPhone.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.8</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ConPhone.Core/ConPhone.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/linko.ico" LogicalName="LINKO.Icon" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../THIRD-PARTY-NOTICES.txt" LogicalName="LINKO.ThirdPartyNotices" /></ItemGroup>
</Project>
